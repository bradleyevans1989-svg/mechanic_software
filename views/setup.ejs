<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Set up · Workshop</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="login-page">
  <form method="post" action="/setup" class="card login">
    <h1>Welcome</h1>
    <p>Create the owner account. You can add your staff after this.</p>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <label>Setup code <input name="code" autocomplete="off" required>
      <span class="hint">Shown in the server log, or the SETUP_CODE you chose.</span></label>
    <label>Your name <input name="name" value="<%= form.name || '' %>" required></label>
    <label>Email <input type="email" name="email" value="<%= form.email || '' %>" autocomplete="username" required></label>
    <label>Password <input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
    <button class="btn primary">Create owner account</button>
  </form>
</body>
</html>
