<%# Editable labour/parts table. Prices are ex GST. %>
<div class="lines" data-lines data-labour-rate="<%= u.dollars(settings.labour_rate_cents) %>">
  <table class="lines-table">
    <thead>
      <tr><th>Type</th><th class="w-desc">Description</th><th class="num">Qty / hrs</th><th class="num">Price ex GST</th><th>GST</th><th class="num">Amount</th><th></th></tr>
    </thead>
    <tbody>
      <% lines.forEach((l, i) => { %>
        <%- include('line-row', { i, l }) %>
      <% }) %>
    </tbody>
  </table>
  <template data-line-template>
    <%- include('line-row', { i: '__i__', l: { kind: 'part', description: '', qty: 1, unit_cents: 0, gst: 1 } }) %>
  </template>
  <div class="lines-actions">
    <button type="button" class="btn small" data-add-line="labour">+ Labour</button>
    <button type="button" class="btn small" data-add-line="part">+ Part</button>
    <button type="button" class="btn small" data-add-line="other">+ Other</button>
  </div>
  <table class="totals">
    <tr><th>Subtotal ex GST</th><td data-total="subtotal"><%= u.money(totals.subtotal) %></td></tr>
    <tr><th>GST</th><td data-total="gst"><%= u.money(totals.gst) %></td></tr>
    <tr class="grand"><th>Total inc GST</th><td data-total="total"><%= u.money(totals.total) %></td></tr>
  </table>
</div>
