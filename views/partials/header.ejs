<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= settings.business_name %></title>
  <link rel="stylesheet" href="/static/style.css">
  <%- include('brand-head') %>
  <script src="/static/app.js" defer></script>
</head>
<body>
<div class="shell">
<header class="topbar">
  <a class="brand" href="/" title="<%= settings.business_name %>"><%- include('mark') %><span class="wordmark">BAY <b>WATCH</b></span></a>
  <span class="brand-ws"><%= settings.business_name %></span>
  <nav class="nav">
    <% const links = [['/', 'Today'], ['/bookings', 'Diary'], ['/jobs', 'Jobs'], ['/estimates', 'Estimates'], ['/invoices', 'Invoices'], ['/customers', 'Customers'], ['/reminders', 'Reminders'], ['/team', 'Team']];
       if (user && user.role === 'owner') links.push(['/reports', 'Reports'], ['/settings', 'Settings']); %>
    <% for (const [href, label] of links) { const active = href === '/' ? path === '/' : href === '/team' ? /^\/(team|procedures|training|roster|clocking)/.test(path) : href === '/customers' ? /^\/(customers|vehicles)/.test(path) : path.startsWith(href); %>
      <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
    <% } %>
  </nav>
  <form class="search" action="/search">
    <input type="search" name="q" value="<%= q %>" placeholder="Search rego, name, phone…" aria-label="Search">
  </form>
  <% if (user) { %>
    <div class="who">
      <a href="/account" title="<%= user.name %> · My account"><%= (user.name || '?').trim().split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase() %></a>
    </div>
  <% } %>
</header>
<% const quick = [
  ['/bookings/new', 'New booking', 'hot', '<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18M12 13v5M9.5 15.5h5"/>'],
  ['/jobs/new', 'New job card', '', '<path d="M14.5 6.5a4 4 0 0 1-5.3 5.3L4 17a1.5 1.5 0 0 0 3 3l5.2-5.2a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.5-2.5z"/>'],
  ['/documents/new?type=quote', 'New estimate', '', '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h5M10 17h5"/>'],
  ['/customers/new', 'New customer', '', '<circle cx="10" cy="8" r="4"/><path d="M3 20a7 7 0 0 1 14 0M19 9v6M16 12h6"/>'],
  ['/clocking', 'Clock on and off', '', '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 3h6"/>'],
  ['/roster', 'Roster', '', '<rect x="3" y="4" width="18" height="17" rx="3"/><path d="M3 10h18M9 10v11M15 10v11"/>'],
  ['/price-list', 'Price list', '', '<path d="M4 6h16M4 12h10M4 18h7"/><circle cx="18" cy="17" r="3"/>'],
]; %>
<%# Bay Watch sits after New job card; added on its own line so redrawn icons above merge cleanly. %>
<% quick.splice(2, 0, ['/baywatch', 'Bay Watch', path.startsWith('/baywatch') ? 'active' : '', '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3.2"/>']); %>
<nav class="rail" aria-label="Quick actions">
  <% for (const [href, label, cls, icon] of quick) { %>
    <a href="<%= href %>" class="<%= cls %>" data-label="<%= label %>" aria-label="<%= label %>"><svg viewBox="0 0 24 24" aria-hidden="true"><%- icon %></svg></a>
  <% } %>
</nav>
<main class="page">
<% if (typeof standing !== 'undefined' && standing && user && user.role === 'owner' && billingEnabled && (standing.reason === 'trial' || standing.reason === 'past_due' || !standing.ok)) { %>
  <div class="banner">
    <% if (standing.reason === 'trial') { %>Free trial: <%= standing.trialDaysLeft %> day<%= standing.trialDaysLeft === 1 ? '' : 's' %> left.<% } else if (standing.reason === 'past_due') { %>Your last payment failed.<% } else { %>Your trial has ended.<% } %>
    <a href="/billing"><%= standing.reason === 'trial' ? 'Subscribe' : 'Fix billing' %></a>
  </div>
<% } %>
