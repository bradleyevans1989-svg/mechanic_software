<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= settings.business_name %></title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><%= settings.business_name %></a>
  <nav class="nav">
    <% const links = [['/', 'Today'], ['/bookings', 'Diary'], ['/jobs', 'Jobs'], ['/quotes', 'Quotes'], ['/invoices', 'Invoices'], ['/customers', 'Customers'], ['/reminders', 'Reminders'], ['/price-list', 'Price list']];
       if (user && user.role === 'owner') links.push(['/reports', 'Reports'], ['/settings', 'Settings']); %>
    <% for (const [href, label] of links) { const active = href === '/' ? path === '/' : path.startsWith(href); %>
      <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
    <% } %>
  </nav>
  <form class="search" action="/search">
    <input type="search" name="q" value="<%= q %>" placeholder="Rego, name, phone, invoice #" aria-label="Search">
  </form>
  <% if (user) { %>
    <div class="who">
      <a href="/account"><%= user.name %></a>
      <form method="post" action="/logout" class="logout"><button class="link">Log out</button></form>
    </div>
  <% } %>
</header>
<% if (typeof standing !== 'undefined' && standing && user && user.role === 'owner' && billingEnabled && (standing.reason === 'trial' || standing.reason === 'past_due' || !standing.ok)) { %>
  <div class="banner">
    <% if (standing.reason === 'trial') { %>Free trial: <%= standing.trialDaysLeft %> day<%= standing.trialDaysLeft === 1 ? '' : 's' %> left.<% } else if (standing.reason === 'past_due') { %>Your last payment failed.<% } else { %>Your trial has ended.<% } %>
    <a href="/billing"><%= standing.reason === 'trial' ? 'Subscribe' : 'Fix billing' %></a>
  </div>
<% } %>
<main class="page">
