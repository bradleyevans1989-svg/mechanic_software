<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <title>Job card J<%= job.number %></title>
  <link rel="stylesheet" href="/static/print.css">
</head>
<body>
  <div class="noprint"><button onclick="window.print()">Print</button> <a href="/jobs/<%= job.id %>">Back to job</a></div>
  <header class="doc-head">
    <div><h1><%= settings.business_name %></h1><div class="pre"><%= settings.address %></div><div><%= settings.phone %></div></div>
    <div class="doc-title"><h2>JOB CARD</h2><div>J<%= job.number %></div><div><%= u.fmtDate(job.created_at) %></div></div>
  </header>
  <section class="parties">
    <div><h3>Customer</h3><strong><%= customer.name %></strong><div><%= customer.phone %></div><div><%= customer.email %></div></div>
    <% if (vehicle) { %>
      <div><h3>Vehicle</h3><strong><%= u.vehicleLabel(vehicle) %></strong><div>VIN <%= vehicle.vin || '—' %></div><div>Odometer <%= job.odometer != null ? job.odometer.toLocaleString('en-AU') + ' km' : '—' %></div></div>
    <% } %>
  </section>
  <h3>Work requested</h3>
  <div class="box pre"><%= job.description || ' ' %></div>
  <h3>Labour and parts</h3>
  <table class="items">
    <thead><tr><th>Description</th><th class="num">Qty</th></tr></thead>
    <tbody>
      <% for (const l of lines) { %><tr><td><%= l.description %></td><td class="num"><%= l.qty %></td></tr><% } %>
      <% for (let i = lines.length; i < 10; i++) { %><tr class="blank"><td>&nbsp;</td><td></td></tr><% } %>
    </tbody>
  </table>
  <h3>Mechanic's notes</h3>
  <div class="box pre tall"><%= job.tech_notes || ' ' %></div>
  <div class="signoff"><div>Mechanic: <%= job.mechanic_name || '____________________' %></div><div>Time: ________ hrs</div></div>
</body>
</html>
