<%- include('../partials/header', { title: 'Jobs' }) %>
<div class="page-head">
  <h1>Jobs</h1>
  <div class="actions">
    <a class="btn <%= view === 'list' ? 'active' : '' %>" href="/jobs?status=<%= filter %>">List</a>
    <a class="btn <%= view === 'board' ? 'active' : '' %>" href="/jobs?status=<%= filter %>&view=board">Board</a>
    <a class="btn" href="/live-board">Live board</a>
    <a class="btn primary" href="/jobs/new">New job</a>
  </div>
</div>
<% const q = view === 'board' ? '&view=board' : ''; %>
<nav class="tabs">
  <a href="/jobs?status=active<%= q %>" class="<%= filter === 'active' ? 'active' : '' %>">In the workshop</a>
  <a href="/jobs?status=mine<%= q %>" class="<%= filter === 'mine' ? 'active' : '' %>">My jobs</a>
  <% for (const [k, label] of Object.entries(JOB_STATUSES)) { %>
    <a href="/jobs?status=<%= k %><%= q %>" class="<%= filter === k ? 'active' : '' %>"><%= label %></a>
  <% } %>
  <a href="/jobs?status=all<%= q %>" class="<%= filter === 'all' ? 'active' : '' %>">All</a>
</nav>

<% function due(j) {
     if (!j.due_date) return '';
     const late = j.due_date < today && j.status !== 'invoiced' && j.status !== 'cancelled';
     return `<span class="${late ? 'late' : ''}">${j.due_date === today ? 'Today' : u.fmtDate(j.due_date)} ${j.due_time || ''}</span>`;
   } %>

<% if (view === 'board') { %>
  <% const cols = Object.entries(JOB_STATUSES).filter(([k]) => filter === 'all' || !['invoiced', 'cancelled'].includes(k) || filter === k); %>
  <div class="board">
    <% for (const [k, label] of cols) { const col = jobs.filter(j => j.status === k); %>
      <div class="col">
        <h3><%= label %> <span class="muted"><%= col.length %></span></h3>
        <% for (const j of col) { %>
          <div class="tile <%= j.priority === 'urgent' ? 'urgent' : '' %>">
            <a class="tile-link" href="/jobs/<%= j.id %>">
            <strong>J<%= j.number %></strong> <%= j.rego ? j.rego.toUpperCase() : '' %> <%= j.make %> <%= j.model %>
            <div class="muted"><%= j.customer_name %></div>
            <div class="desc"><%= j.description %></div>
            </a>
            <div class="meta">
              <% if (j.status === 'invoiced' || j.status === 'cancelled') { %><% if (j.mechanic_name) { %><span><%= j.mechanic_name %></span><% } %><% } else { %><%- include('../partials/assign', { job: j, back: '/jobs?status=' + filter + '&view=board' }) %><% } %>
              <% if (j.clocked_on) { %><span title="Someone is clocked on">⏱</span><% } %>
              <% if (j.flagged) { %><span class="late">⚠ <%= j.flagged %></span><% } %>
              <%- due(j) %>
            </div>
          </div>
        <% } %>
        <% if (!col.length) { %><p class="muted small">None</p><% } %>
      </div>
    <% } %>
  </div>
<% } else { %>
<table class="table card">
  <thead><tr><th>Job</th><th>Vehicle</th><th>Customer</th><th>Work</th><th>Mechanic</th><th>Promised</th><th>Status</th></tr></thead>
  <tbody>
    <% for (const j of jobs) { %>
      <tr class="rowlink <%= j.priority === 'urgent' ? 'urgent' : '' %>" data-href="/jobs/<%= j.id %>">
        <td><a href="/jobs/<%= j.id %>">J<%= j.number %></a><% if (j.priority === 'urgent') { %> <span class="late">Urgent</span><% } %></td>
        <td><%= j.rego || '' %> <%= j.make %> <%= j.model %></td>
        <td><%= j.customer_name %></td>
        <td><%= j.description %><% if (j.flagged) { %> <span class="late">⚠ <%= j.flagged %></span><% } %></td>
        <td><% if (j.status === 'invoiced' || j.status === 'cancelled') { %><%= j.mechanic_name || '' %><% } else { %><%- include('../partials/assign', { job: j, back: '/jobs?status=' + filter }) %><% } %><%= j.clocked_on ? ' ⏱' : '' %></td>
        <td><%- due(j) || '<span class="muted">' + u.fmtDate(j.created_at) + '</span>' %></td>
        <td>
          <% if (j.status === 'invoiced' || j.status === 'cancelled') { %>
            <%- include('../partials/pill', { state: j.status, label: JOB_STATUSES[j.status] }) %>
          <% } else { %>
            <form method="post" action="/jobs/<%= j.id %>/status" class="status-form">
              <input type="hidden" name="back" value="/jobs?status=<%= filter %>">
              <select name="status" class="pill-select pill-<%= j.status %>" data-auto-submit aria-label="Status of job J<%= j.number %>">
                <% for (const [k, label] of Object.entries(JOB_STATUSES)) { if (k === 'invoiced') continue; %><option value="<%= k %>" <%= j.status === k ? 'selected' : '' %>><%= label %></option><% } %>
                <option value="invoice">Make invoice →</option>
              </select>
              <noscript><button class="btn small">Save</button></noscript>
            </form>
          <% } %>
        </td>
      </tr>
    <% } %>
    <% if (!jobs.length) { %><tr><td colspan="7" class="muted">No jobs here.</td></tr><% } %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
