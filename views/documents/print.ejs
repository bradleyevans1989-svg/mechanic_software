<% const isQuote = doc.type === 'quote'; const label = isQuote ? 'ESTIMATE' : 'TAX INVOICE';
   const isShared = typeof shared !== 'undefined' && shared;
   const isPreview = typeof preview !== 'undefined' && preview;
   const tpl = typeof template !== 'undefined' && template ? template : (settings.invoice_template || 'classic');
   const logoUrl = settings.has_logo ? (isShared ? `/share/${token}/logo` : '/logo') : '';
   const contact = [settings.phone, settings.email, settings.website].filter(Boolean).join(' · ');
   const ids = [settings.abn ? 'ABN ' + settings.abn : '', settings.licence].filter(Boolean).join(' · '); %>
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= isQuote ? 'Estimate' : 'Invoice' %> <%= u.docNumber(doc) %> · <%= settings.business_name %></title>
  <link rel="stylesheet" href="/static/print.css">
  <%- include('../partials/brand-head') %>
</head>
<body class="tpl tpl-<%= tpl %> <%= logoUrl ? 'has-logo' : 'no-logo' %>" style="--brand: <%= settings.brand_colour || '#111111' %>">
  <% if (isPreview) { %>
  <% } else if (isShared) { %>
    <div class="noprint">
      <button onclick="window.print()">Print or save as PDF</button>
      <% if (isQuote && (doc.status === 'draft' || doc.status === 'sent')) { %>
        <form method="post" action="/share/<%= token %>/accept" style="display:inline" onsubmit="return confirm('Accept this estimate and have <%= settings.business_name %> go ahead with the work?')"><button>Accept this estimate</button></form>
      <% } else if (isQuote && doc.status === 'accepted') { %>
        <strong>✓ Estimate accepted<%= typeof accepted !== 'undefined' && accepted ? '. Thanks! The workshop will be in touch.' : '.' %></strong>
      <% } %>
      <% if (settings.phone) { %><span>Questions? Call <%= settings.business_name %> on <%= settings.phone %>.</span><% } %>
    </div>
  <% } else { %>
    <div class="noprint"><button onclick="window.print()">Print or save as PDF</button> <a href="/documents/<%= doc.id %>">Back</a></div>
  <% } %>
  <div class="sheet">
    <header class="doc-head">
      <div class="biz">
        <% if (logoUrl) { %><img class="logo" src="<%= logoUrl %>" alt=""><% } %>
        <div class="biz-text">
          <h1><%= settings.business_name %></h1>
          <% if (settings.tagline) { %><div class="tagline"><%= settings.tagline %></div><% } %>
          <div class="pre addr"><%= settings.address %></div>
          <% if (contact) { %><div class="contact"><%= contact %></div><% } %>
          <% if (ids) { %><div class="ids"><%= ids %></div><% } %>
        </div>
      </div>
      <div class="doc-title">
        <h2><%= doc.state === 'void' ? 'VOID ' : '' %><%= label %></h2>
        <table class="meta">
          <tr><th>Number</th><td><%= u.docNumber(doc) %></td></tr>
          <tr><th>Date</th><td><%= u.fmtDate(doc.issue_date) %></td></tr>
          <% if (doc.due_date) { %><tr><th><%= isQuote ? 'Valid until' : 'Due' %></th><td><%= u.fmtDate(doc.due_date) %></td></tr><% } %>
          <% if (!isQuote) { %><tr class="meta-total"><th>Amount due</th><td><%= u.money(doc.balance) %></td></tr><% } %>
        </table>
      </div>
    </header>
    <section class="parties">
      <div class="party">
        <h3><%= isQuote ? 'Prepared for' : 'Bill to' %></h3>
        <strong><%= customer.name %></strong>
        <div class="pre"><%= customer.address %></div>
        <div><%= customer.phone %></div><div><%= customer.email %></div>
      </div>
      <% if (vehicle) { %>
        <div class="party">
          <h3><%= vt.asset %></h3>
          <strong><%= u.vehicleLabel(vehicle) %></strong>
          <% if (vehicle.vin) { %><div><%= vt.vin %> <%= vehicle.vin %></div><% } %>
          <% if (doc.odometer) { %><div><%= vt.meter %> <%= doc.odometer.toLocaleString('en-AU') %> <%= vt.unit %></div><% } %>
        </div>
      <% } %>
    </section>
    <% if (doc.notes) { %><div class="box pre notes"><%= doc.notes %></div><% } %>
    <table class="items">
      <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Unit ex GST</th><th class="num">GST</th><th class="num">Amount ex GST</th></tr></thead>
      <tbody>
        <% for (const l of lines) { %>
          <tr class="kind-<%= l.kind || 'other' %>">
            <td><%= l.description %></td>
            <td class="num"><%= l.qty %></td>
            <td class="num"><%= u.money(l.unit_cents) %></td>
            <td class="num"><%= l.gst ? '10%' : 'Free' %></td>
            <td class="num"><%= u.money(u.lineTotal(l)) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <div class="sum-wrap">
      <table class="sum">
        <tr><th>Subtotal ex GST</th><td><%= u.money(doc.subtotal) %></td></tr>
        <tr><th>GST</th><td><%= u.money(doc.gst) %></td></tr>
        <tr class="grand"><th>Total inc GST</th><td><%= u.money(doc.total) %></td></tr>
        <% if (!isQuote && doc.paid) { %>
          <tr><th>Paid</th><td><%= u.money(doc.paid) %></td></tr>
          <tr class="grand due"><th>Balance due</th><td><%= u.money(doc.balance) %></td></tr>
        <% } %>
      </table>
    </div>
    <footer class="doc-foot">
      <% if (!isQuote && settings.bank_details && doc.balance > 0) { %><div class="pay"><h3>How to pay</h3><div class="pre"><%= settings.bank_details %></div></div><% } %>
      <% if (isQuote && doc.due_date) { const days = Math.round((Date.parse(doc.due_date) - Date.parse(doc.issue_date)) / 86400000); %>
        <p class="validity">This estimate is valid for <%= days %> day<%= days === 1 ? '' : 's' %>, until <%= u.fmtDate(doc.due_date) %>. Prices may change after that date, and the final invoice may differ if extra work or parts are needed once we start.</p>
      <% } %>
      <% if (settings.invoice_terms) { %><div class="pre terms"><%= settings.invoice_terms %></div><% } %>
    </footer>
  </div>
  <%- include('../partials/made-with') %>
</body>
</html>
