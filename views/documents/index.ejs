<% const isQuote = type === 'quote'; const base = isQuote ? '/estimates' : '/invoices';
   const qs = new URLSearchParams(); if (filters.q) qs.set('q', filters.q); if (filters.from) qs.set('from', filters.from); if (filters.to) qs.set('to', filters.to);
   for (const st of filters.state) qs.append('state', st); if (filters.sort !== 'newest') qs.set('sort', filters.sort); if (filters.show === 'all') qs.set('show', 'all');
   const query = qs.toString() ? '?' + qs.toString() : ''; %>
<%- include('../partials/header', { title: isQuote ? 'Estimates' : 'Invoices' }) %>
<div class="page-head">
  <h1><%= isQuote ? 'Estimates' : 'Invoices' %> <span class="muted"><%= docs.length %> shown</span></h1>
  <div class="actions">
    <a class="btn" href="<%= base %>.csv<%= query %>">Download</a>
    <% if (!isQuote) { %><a class="btn" href="/reports">Reports</a><% } %>
    <a class="btn primary" href="/documents/new?type=<%= type %>">New <%= type %></a>
  </div>
</div>
<% if (done) { %><p class="flash"><%= done %> updated.</p><% } %>
<form class="toolbar card" method="get" action="<%= base %>">
  <div class="toolbar-row">
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Search number, customer, rego, phone" aria-label="Search" class="toolbar-search">
    <label class="inline">From <input type="date" name="from" value="<%= filters.from %>"></label>
    <label class="inline">To <input type="date" name="to" value="<%= filters.to %>"></label>
    <label class="inline">Sort
      <select name="sort"><% for (const [k, s] of Object.entries(sorts)) { %><option value="<%= k %>" <%= filters.sort === k ? 'selected' : '' %>><%= s.label %></option><% } %></select>
    </label>
    <button class="btn">Apply</button>
    <% if (query) { %><a class="btn" href="<%= base %>">Clear</a><% } %>
  </div>
  <div class="toolbar-row checks-row">
    <span class="muted small">Status</span>
    <% for (const st of states) { %>
      <label class="check small"><input type="checkbox" name="state" value="<%= st %>" <%= filters.state.includes(st) ? 'checked' : '' %>><span class="pill pill-<%= st.replace(/\s+/g, '-') %>"><%= st %></span></label>
    <% } %>
    <span class="muted small sep">Quick</span>
    <% if (isQuote) { %>
      <a href="<%= base %>" class="btn small <%= filter === 'open' ? 'active' : '' %>">Open</a>
    <% } else { %>
      <a href="<%= base %>" class="btn small <%= filter === 'unpaid' ? 'active' : '' %>">Owing</a>
    <% } %>
    <a href="<%= base %>?show=all" class="btn small <%= filter === 'all' ? 'active' : '' %>">All</a>
  </div>
</form>
<form method="post" action="/documents/bulk" id="bulk">
  <input type="hidden" name="type" value="<%= type %>">
  <input type="hidden" name="back" value="<%= query %>">
  <div class="bulk-bar" data-bulk-bar hidden>
    <span><b data-bulk-count>0</b> selected</span>
    <select name="action" aria-label="Bulk action">
      <option value="">Choose an action…</option>
      <option value="sent">Mark as sent</option>
      <option value="download">Download selected</option>
      <% if (isQuote) { %><option value="declined">Mark as declined</option><option value="delete">Delete</option><% } else { %><option value="void">Void (unpaid only)</option><% } %>
    </select>
    <button class="btn small primary" data-confirm-btn="Apply this to the selected <%= type %>s?">Apply</button>
  </div>
  <table class="table card">
    <thead><tr><th class="tick-cell"><input type="checkbox" data-check-all aria-label="Select all"></th><th>#</th><th>Date</th><th>Customer</th><th>Vehicle</th><th class="num">Total</th><% if (!isQuote) { %><th class="num">Balance</th><% } %><th>Status</th></tr></thead>
    <tbody>
      <% for (const d of docs) { %>
        <tr class="rowlink" data-href="/documents/<%= d.id %>">
          <td class="tick-cell"><input type="checkbox" name="ids" value="<%= d.id %>" data-check aria-label="Select <%= u.docNumber(d) %>"></td>
          <td><a href="/documents/<%= d.id %>"><%= u.docNumber(d) %></a><% if (d.sent_at) { %> <span class="muted small" title="Sent to the customer">✉</span><% } %></td>
          <td><%= u.fmtDate(d.issue_date) %></td>
          <td><%= d.customer_name %></td>
          <td><%= d.rego || '' %> <span class="muted"><%= [d.make, d.model].filter(Boolean).join(' ') %></span></td>
          <td class="num"><%= u.money(d.total) %></td>
          <% if (!isQuote) { %><td class="num"><%= u.money(d.balance) %></td><% } %>
          <td><%- include('../partials/pill', { state: d.state, label: d.state }) %></td>
        </tr>
      <% } %>
      <% if (!docs.length) { %><tr><td colspan="8" class="muted">Nothing matches. <a href="<%= base %>?show=all">Show all</a></td></tr><% } %>
    </tbody>
  </table>
</form>
<%- include('../partials/footer') %>
