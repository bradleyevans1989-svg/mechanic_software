<% const isQuote = doc.type === 'quote'; const label = isQuote ? 'Estimate' : 'Tax invoice'; %>
<%- include('../partials/header', { title: label + ' ' + u.docNumber(doc) }) %>
<div class="page-head">
  <div>
    <h1><%= label %> <%= u.docNumber(doc) %> <%- include('../partials/pill', { state: doc.state, label: isQuote ? QUOTE_STATUSES[doc.status] : doc.state }) %></h1>
    <p>
      <a href="/customers/<%= doc.customer_id %>"><%= doc.customer_name %></a>
      <% if (doc.vehicle_id) { %> · <a href="/vehicles/<%= doc.vehicle_id %>"><%= u.vehicleLabel(doc) %></a><% } %>
      <% if (doc.job_id) { %> · <a href="/jobs/<%= doc.job_id %>">Job card</a><% } %>
      <% for (const c of converted) { %> · <a href="/documents/<%= c.id %>"><%= c.type === 'quote' ? 'Estimate' : 'Invoice' %> <%= u.docNumber(c) %></a><% } %>
    </p>
  </div>
  <div class="actions">
    <a class="btn" href="/documents/<%= doc.id %>/print" target="_blank">Print / PDF</a>
    <a class="btn" href="#send">Send to customer</a>
    <% if (isQuote) { %>
      <form method="post" action="/documents/<%= doc.id %>/job"><button class="btn">Accept: create job</button></form>
      <form method="post" action="/documents/<%= doc.id %>/invoice"><button class="btn primary">Convert to invoice</button></form>
    <% } %>
  </div>
</div>
<% if (saved) { %><p class="flash">Saved.</p><% } %>
<% if (sent) { %><p class="flash">Marked as sent<%= doc.sent_to ? ' to ' + doc.sent_to : '' %>.</p><% } %>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (doc.customer_accepted_at) { %><p class="flash">Accepted online by the customer on <%= u.fmtDateTime(doc.customer_accepted_at, settings.timezone) %>.</p><% } %>
<% if (xeroStatus) { %>
  <div class="xero-status">
    Xero: <% if (xeroStatus.status === 'synced') { %><strong>sent</strong><% } else if (xeroStatus.status === 'error') { %><strong class="error">failed</strong><% } else if (xeroStatus.status === 'skipped') { %>waiting for items<% } else { %><%= xeroStatus.status === 'pending' ? 'sending…' : 'not sent' %><% } %>
    <% if (xeroStatus.error) { %><span class="error"><%= xeroStatus.error %></span><% } %>
    <% if (xeroStatus.status !== 'synced' || xeroStatus.error) { %>
      <form method="post" action="/documents/<%= doc.id %>/xero"><button class="btn small">Send to Xero now</button></form>
    <% } %>
  </div>
<% } %>
<% if (doc.state === 'void') { %><p class="banner warn">This invoice is void and is left out of reports.</p><% } %>

<form method="post" action="/documents/<%= doc.id %>" class="card form" data-dirty-check>
  <div class="grid-4">
    <label>Date <input type="date" name="issue_date" value="<%= doc.issue_date %>"></label>
    <label><%= isQuote ? 'Valid until' : 'Due' %> <input type="date" name="due_date" value="<%= doc.due_date || '' %>"></label>
    <label>Odometer (km) <input name="odometer" inputmode="numeric" value="<%= doc.odometer ?? '' %>"></label>
    <% if (isQuote) { %>
      <label>Status
        <select name="status">
          <% for (const [k, l] of Object.entries(QUOTE_STATUSES)) { %><option value="<%= k %>" <%= doc.status === k ? 'selected' : '' %>><%= l %></option><% } %>
        </select>
      </label>
    <% } %>
  </div>
  <label>Notes <span class="muted">(shown on the <%= isQuote ? 'quote' : 'invoice' %>)</span><textarea name="notes" rows="2"><%= doc.notes %></textarea></label>
  <h2>Items</h2>
  <%- include('../partials/lines', { lines, totals: doc }) %>
  <div class="form-actions sticky"><button class="btn primary">Save</button></div>
</form>

<% const body = 'Hi ' + doc.customer_name.split(' ')[0] + ', here is your ' + label.toLowerCase() + ' ' + u.docNumber(doc) + ' for ' + u.money(doc.total) + ' from ' + settings.business_name + (isQuote ? '. You can view and accept it here: ' : '. You can view it here: ') + shareUrl; %>
<section class="card" id="send">
  <h2>Send to customer</h2>
  <% if (doc.sent_at) { %><p class="muted">Last sent by <%= doc.sent_via === 'sms' ? 'text' : doc.sent_via === 'link' ? 'link' : 'email' %><%= doc.sent_to ? ' to ' + doc.sent_to : '' %> on <%= u.fmtDateTime(doc.sent_at, settings.timezone) %>.</p><% } %>
  <p>The customer can open this link to see the <%= label.toLowerCase() %><%= isQuote ? ' and accept it' : (typeof payOnline !== 'undefined' && payOnline ? ' and pay it online' : '') %>, no login needed:</p>
  <p><input value="<%= shareUrl %>" readonly onclick="this.select()" aria-label="Link for the customer"></p>
  <div class="actions">
    <% if (canEmail) { %>
      <form method="post" action="/documents/<%= doc.id %>/send" class="inline-form">
        <input type="hidden" name="via" value="email">
        <label>Email to <input name="to" type="email" value="<%= doc.customer_email %>" required style="width:16rem"></label>
        <button class="btn primary">Email it</button>
      </form>
    <% } else if (doc.customer_email) { %>
      <form method="post" action="/documents/<%= doc.id %>/send" class="inline-form">
        <input type="hidden" name="via" value="mailto"><input type="hidden" name="to" value="<%= doc.customer_email %>">
        <a class="btn" href="mailto:<%= doc.customer_email %>?subject=<%= encodeURIComponent(label + ' ' + u.docNumber(doc) + ' from ' + settings.business_name) %>&body=<%= encodeURIComponent(body) %>" data-then-submit>Email</a>
      </form>
    <% } %>
    <% if (doc.customer_phone && smsReady) { %>
      <form method="post" action="/customers/<%= doc.customer_id %>/messages" class="inline-form">
        <input type="hidden" name="kind" value="document"><input type="hidden" name="document_id" value="<%= doc.id %>">
        <input type="hidden" name="back" value="/documents/<%= doc.id %>#send"><input type="hidden" name="body" value="<%= body %>">
        <label>Text to <input name="phone" value="<%= doc.customer_phone %>" style="width:10rem"></label>
        <button class="btn">Text it</button>
      </form>
    <% } else if (doc.customer_phone) { %>
      <form method="post" action="/documents/<%= doc.id %>/send" class="inline-form">
        <input type="hidden" name="via" value="sms"><input type="hidden" name="to" value="<%= doc.customer_phone %>">
        <a class="btn" href="sms:<%= doc.customer_phone %>?&body=<%= encodeURIComponent(body) %>" data-then-submit>Text</a>
      </form>
    <% } %>
    <form method="post" action="/documents/<%= doc.id %>/send"><input type="hidden" name="via" value="link"><button class="btn small">Mark as sent</button></form>
  </div>
  <% if (!canEmail) { %><p class="hint">Email and Text open your own email or messages app with the link filled in. Sending straight from here needs an email service set up on the server (see the README).</p><% } %>
</section>

<% if (!isQuote) { %>
  <section class="card">
    <h2>Payments <span class="muted">Balance <%= u.money(doc.balance) %></span></h2>
    <table class="table">
      <% for (const p of payments) { %>
        <tr>
          <td><%= u.fmtDate(p.date) %></td><td><%= p.method %></td><td class="num"><%= u.money(p.amount_cents) %></td>
          <td><form method="post" action="/documents/<%= doc.id %>/payments/<%= p.id %>/delete" data-confirm="Remove this payment?"><button class="icon" aria-label="Remove payment">×</button></form></td>
        </tr>
      <% } %>
      <% if (!payments.length) { %><tr><td class="muted">No payments yet.</td></tr><% } %>
    </table>
    <% if (doc.state !== 'void') { %>
      <form method="post" action="/documents/<%= doc.id %>/payments" class="inline-form">
        <label>Amount <input name="amount" inputmode="decimal" value="<%= doc.balance > 0 ? u.dollars(doc.balance) : '' %>" required></label>
        <label>Date <input type="date" name="date" value="<%= today %>"></label>
        <label>Method
          <select name="method"><option>EFTPOS</option><option>Card</option><option>Cash</option><option>Bank transfer</option><option>Other</option></select>
        </label>
        <button class="btn primary">Record payment</button>
      </form>
    <% } %>
  </section>

  <section class="card" id="review">
    <h2>Google review</h2>
    <% if (!settings.review_url) { %>
      <p class="muted">Add your Google review link under <a href="/settings/reviews">Settings → Google reviews</a> to ask happy customers for a review from here.</p>
    <% } else { const reviewText = reviewMessage; %>
      <% if (doc.review_requested_at) { %><p class="muted">Asked by <%= doc.review_via === 'sms' ? 'text' : 'email' %> on <%= u.fmtDateTime(doc.review_requested_at, settings.timezone) %>.</p><% } %>
      <% if (doc.state !== 'paid' && !doc.review_requested_at) { %><p class="muted">Best asked once the invoice is paid<%= settings.review_auto && canEmail ? '. It will go by email on its own then.' : '.' %></p><% } %>
      <div class="actions">
        <% if (canEmail && doc.customer_email) { %>
          <form method="post" action="/documents/<%= doc.id %>/review"><input type="hidden" name="via" value="email"><button class="btn<%= doc.review_requested_at ? '' : ' primary' %>">Ask for a review by email</button></form>
        <% } %>
        <% if (doc.customer_phone) { %>
          <form method="post" action="/documents/<%= doc.id %>/review" class="inline-form">
            <input type="hidden" name="via" value="sms">
            <a class="btn" href="<%= reviewSms %>" data-then-submit>Ask by text</a>
          </form>
        <% } %>
      </div>
      <p class="hint">"<%= reviewText %>"</p>
    <% } %>
  </section>
<% } %>

<div class="actions">
  <% if (isQuote) { %>
    <form method="post" action="/documents/<%= doc.id %>/delete" data-confirm="Delete this estimate?"><button class="btn danger small">Delete estimate</button></form>
  <% } else if (doc.state === 'void') { %>
    <form method="post" action="/documents/<%= doc.id %>/unvoid"><button class="btn small">Restore invoice</button></form>
  <% } else { %>
    <form method="post" action="/documents/<%= doc.id %>/void" data-confirm="Void this invoice? It keeps its number but is left out of reports."><button class="btn danger small">Void invoice</button></form>
  <% } %>
</div>
<%- include('../partials/footer') %>
