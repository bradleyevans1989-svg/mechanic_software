<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in · <%= settings.business_name %></title>
  <link rel="stylesheet" href="/static/style.css">
  <%- include('partials/brand-head') %>
</head>
<body class="login-page">
  <form method="post" action="/login" class="card login">
    <div class="login-logo"><%- include('partials/mark') %><div class="wordmark">BAY <b>WATCH</b></div><div class="tagline">Workshop software</div></div>
    <h1>Log in</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <label>Email <input type="email" name="email" value="<%= email %>" autocomplete="username" autofocus required></label>
    <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn primary">Log in</button>
    <p class="hint">Forgot your password? Ask your workshop owner to reset it.</p>
    <p class="hint">New workshop? <a href="/signup">Create an account</a> or <a href="/workshops">see who it's for</a></p>
  </form>
</body>
</html>
