<%- include('../partials/header', { title: customer.id ? 'Edit customer' : 'New customer' }) %>
<h1><%= customer.id ? 'Edit ' + customer.name : 'New customer' %></h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="<%= customer.id ? '/customers/' + customer.id : '/customers' %>" class="card form">
  <div class="grid-2">
    <label>Name <input name="name" value="<%= customer.name || '' %>" required autofocus></label>
    <label>Phone <input name="phone" type="tel" value="<%= customer.phone || '' %>"></label>
    <label>Email <input name="email" type="email" value="<%= customer.email || '' %>"></label>
    <label>Address <input name="address" value="<%= customer.address || '' %>"></label>
  </div>
  <div class="grid-2">
    <fieldset class="choice">
      <legend>Type</legend>
      <label class="check"><input type="radio" name="kind" value="individual" <%= customer.kind !== 'company' ? 'checked' : '' %>> Individual</label>
      <label class="check"><input type="radio" name="kind" value="company" <%= customer.kind === 'company' ? 'checked' : '' %>> Company</label>
    </fieldset>
    <label>Tags <input name="tags" value="<%= customer.tags || '' %>" placeholder="fleet, VIP, account"><span class="hint">Separate with commas. Use them to filter the customer list.</span></label>
  </div>
  <label>Notes <textarea name="notes" rows="2"><%= customer.notes || '' %></textarea></label>

  <% if (withVehicle) { %>
    <h2>Vehicle <span class="muted">(optional)</span></h2>
    <div class="grid-3">
      <label>Rego <input name="v_rego" class="upper"></label>
      <label>Make <input name="v_make" placeholder="Toyota"></label>
      <label>Model <input name="v_model" placeholder="Hilux"></label>
      <label>Year <input name="v_year" inputmode="numeric"></label>
      <label>Odometer (km) <input name="v_odometer" inputmode="numeric"></label>
      <label>VIN <input name="v_vin" class="upper"></label>
    </div>
  <% } %>
  <div class="form-actions">
    <button class="btn primary">Save</button>
    <a class="btn" href="<%= customer.id ? '/customers/' + customer.id : '/customers' %>">Cancel</a>
  </div>
</form>
<% if (customer.id) { %>
  <form method="post" action="/customers/<%= customer.id %>/delete" data-confirm="Delete this customer? They move to the deleted list and can be restored later.">
    <button class="btn danger small">Delete customer</button>
  </form>
<% } %>
<%- include('../partials/footer') %>
