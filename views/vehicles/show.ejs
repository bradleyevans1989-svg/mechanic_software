<%- include('../partials/header', { title: vehicle.rego || vt.asset }) %>
<div class="page-head">
  <div>
    <h1><%= u.vehicleLabel(vehicle) || vt.asset %></h1>
    <p>Owner: <a href="/customers/<%= customer.id %>"><%= customer.name %></a><% if (customer.phone) { %> · <a href="tel:<%= customer.phone %>"><%= customer.phone %></a><% } %></p>
  </div>
  <div class="actions">
    <a class="btn" href="/vehicles/<%= vehicle.id %>/edit">Edit</a>
    <a class="btn" href="/bookings/new?vehicle_id=<%= vehicle.id %>">Book in</a>
    <a class="btn" href="/documents/new?type=quote&vehicle_id=<%= vehicle.id %>">Estimate</a>
    <a class="btn primary" href="/jobs/new?vehicle_id=<%= vehicle.id %>">New job</a>
  </div>
</div>

<section class="card">
  <dl class="facts">
    <div><dt>Colour</dt><dd><%= vehicle.colour || '—' %></dd></div>
    <div><dt><%= vt.vin %></dt><dd><%= vehicle.vin || '—' %></dd></div>
    <div><dt><%= vt.meter %></dt><dd><%= vehicle.odometer != null ? vehicle.odometer.toLocaleString('en-AU') + ' ' + vt.unit : '—' %></dd></div>
    <div><dt><%= vt.rego %> due</dt><dd><%= u.fmtDate(vehicle.rego_due) || '—' %></dd></div>
    <div><dt>Next service</dt><dd><%= u.fmtDate(vehicle.next_service_date) || '—' %><%= vehicle.next_service_km ? ' or ' + vehicle.next_service_km.toLocaleString('en-AU') + ' ' + vt.unit : '' %></dd></div>
    <div><dt>Last service</dt><dd><%= u.fmtDate(vehicle.last_service_date) || '—' %></dd></div>
    <div><dt>Service interval</dt><dd><%= vehicle.service_interval_months ? 'every ' + vehicle.service_interval_months + ' months' : '' %><%= vehicle.service_interval_months && vehicle.service_interval_km ? ' or ' : '' %><%= vehicle.service_interval_km ? vehicle.service_interval_km.toLocaleString('en-AU') + ' ' + vt.unit : '' %><%= !vehicle.service_interval_months && !vehicle.service_interval_km ? '—' : '' %></dd></div>
  </dl>
  <% if (reminders.length) { %>
    <h3>Reminders sent</h3>
    <ul class="compact">
      <% for (const r of reminders) { %><li><%= u.fmtDateTime(r.at, settings.timezone) %> · <%= r.kind === 'rego' ? 'Rego' : 'Service' %> reminder by <%= r.method || 'phone' %><%= r.user_name ? ' (' + r.user_name + ')' : '' %><%= r.note ? ' — ' + r.note : '' %></li><% } %>
    </ul>
  <% } %>
  <% if (vehicle.notes) { %><p class="note"><%= vehicle.notes %></p><% } %>
</section>

<section class="card">
  <h2>Owner</h2>
  <% if (moved) { %><p class="flash">Moved to <%= customer.name %>.</p><% } %>
  <ul class="list compact">
    <% for (const o of owners) { %>
      <li>
        <span><a href="/customers/<%= o.customer_id %>"><strong><%= o.customer_name %></strong></a> <span class="muted">from <%= u.fmtDate(o.from_at) %><%= o.to_at ? ' to ' + u.fmtDate(o.to_at) : '' %><%= o.note ? ' · ' + o.note : '' %></span></span>
        <% if (!o.to_at) { %><span class="pill pill-paid">current</span><% } %>
      </li>
    <% } %>
  </ul>
  <details class="transfer">
    <summary class="btn small">Move to another customer</summary>
    <form method="post" action="/vehicles/<%= vehicle.id %>/transfer" class="form" data-confirm="Move this <%= vt.assetLower %>? Past jobs and invoices stay with <%= customer.name %>.">
      <div class="grid-2">
        <label>Existing customer
          <select name="customer_id"><option value="">Choose…</option><% for (const c of customers) { if (c.id === customer.id) continue; %><option value="<%= c.id %>"><%= c.name %><%= c.phone ? ' · ' + c.phone : '' %></option><% } %></select>
        </label>
        <label>Or a new customer <input name="new_name" placeholder="Name"></label>
        <label>Their phone <input name="new_phone" type="tel"></label>
        <label>Note <input name="note" placeholder="Sold privately, fleet reassignment…"></label>
      </div>
      <p class="hint">The new owner gets the <%= vt.assetLower %> from today. Jobs, estimates and invoices already done stay with the customer they were billed to.</p>
      <button class="btn primary small">Move <%= vt.assetLower %></button>
    </form>
  </details>
</section>

<section class="card">
  <h2>Service history</h2>
  <% if (!history.length) { %><p class="muted">No invoiced work yet.</p><% } %>
  <% for (const h of history) { %>
    <div class="history-item">
      <div class="history-head">
        <a href="/documents/<%= h.doc.id %>"><strong><%= u.fmtDate(h.doc.issue_date) %></strong> · <%= u.docNumber(h.doc) %></a>
        <span><%= h.doc.odometer ? h.doc.odometer.toLocaleString('en-AU') + ' ' + vt.unit + ' · ' : '' %><%= u.money(h.doc.total) %></span>
      </div>
      <% if (h.doc.notes) { %><p class="muted"><%= h.doc.notes %></p><% } %>
      <ul class="compact">
        <% for (const l of h.lines) { %><li><%= l.description %><%= l.kind === 'part' && l.qty !== 1 ? ' × ' + l.qty : '' %></li><% } %>
      </ul>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>Jobs and estimates</h2>
  <div class="table-wrap">
    <table class="table">
      <% for (const j of jobs) { %>
        <tr><td><a href="/jobs/<%= j.id %>">Job J<%= j.number %></a></td><td><%= u.fmtDate(j.created_at) %></td><td><%= j.description %></td><td><%- include('../partials/pill', { state: j.status, label: JOB_STATUSES[j.status] }) %></td></tr>
      <% } %>
      <% for (const d of docs.filter(d => d.type === 'quote')) { %>
        <tr><td class="nowrap"><a href="/documents/<%= d.id %>">Estimate <%= u.docNumber(d) %></a></td><td><%= u.fmtDate(d.issue_date) %></td><td><%= u.money(d.total) %></td><td><%- include('../partials/pill', { state: d.state, label: d.state }) %></td></tr>
      <% } %>
      <% if (!jobs.length && !docs.some(d => d.type === 'quote')) { %><tr><td class="muted">None yet.</td></tr><% } %>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
