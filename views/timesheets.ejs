<%- include('partials/header', { title: 'Timesheets' }) %>
<div class="page-head">
  <h1>Timesheets <span class="muted">week of <%= u.fmtDate(start) %></span></h1>
  <div class="actions">
    <a class="btn" href="/timesheets?week=<%= prev %>">← Prev</a>
    <a class="btn" href="/timesheets">This week</a>
    <a class="btn" href="/timesheets?week=<%= next %>">Next →</a>
  </div>
</div>
<% if (onClock.length) { %>
  <p class="banner warn">On the clock now: <% onClock.forEach((e, i) => { %><%= i ? ', ' : '' %><a href="/jobs/<%= e.job_id %>"><%= rows.find(r => r.id === e.user_id)?.name || 'Someone' %> on J<%= e.job_number %></a><% }) %></p>
<% } %>
<h2>Shift hours <span class="muted">from clocking, breaks taken out</span></h2>
<% if (openShifts.length) { %>
  <div class="card">
    <p class="banner warn">Shifts never finished:</p>
    <% for (const c of openShifts) { %>
      <form method="post" action="/clocking/<%= c.id %>/fix" class="inline-form mt">
        <span><strong><%= rows.find(r => r.id === c.user_id)?.name || 'Someone' %></strong> started <%= u.fmtDateTime(c.started_at, settings.timezone) %></span>
        <label>Finished at <input type="datetime-local" name="ended_at" value="<%= c.day %>T17:00" required></label>
        <button class="btn small primary">Fix</button>
      </form>
    <% } %>
  </div>
<% } %>
<table class="table card">
  <thead>
    <tr><th>Staff</th><% const dn = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']; days.forEach((d, i) => { %><th class="num <%= d === today ? 'today' : '' %>"><%= dn[i] %><br><span class="muted small"><%= u.fmtDate(d).slice(0, 5) %></span></th><% }) %><th class="num">Week</th></tr>
  </thead>
  <tbody>
    <% for (const r of rows) { %>
      <tr>
        <td><%= r.name %><%= r.active ? '' : ' (inactive)' %></td>
        <% r.shiftByDay.forEach((m) => { %><td class="num"><%= m ? (m / 60).toFixed(2) : '' %></td><% }) %>
        <td class="num"><strong><%= (r.shiftTotal / 60).toFixed(2) %></strong></td>
      </tr>
    <% } %>
    <% if (!rows.length) { %><tr><td colspan="9" class="muted">No staff yet.</td></tr><% } %>
  </tbody>
  <tfoot>
    <tr><th>Total hours</th><% shiftDayTotals.forEach((m) => { %><th class="num"><%= m ? (m / 60).toFixed(2) : '' %></th><% }) %><th class="num"><%= (shiftDayTotals.reduce((s, m) => s + m, 0) / 60).toFixed(2) %></th></tr>
  </tfoot>
</table>
<h2>Hours on jobs <span class="muted">from the clock on each job card</span></h2>
<table class="table card">
  <thead>
    <tr><th>Staff</th><% const names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']; days.forEach((d, i) => { %><th class="num <%= d === today ? 'today' : '' %>"><%= names[i] %><br><span class="muted small"><%= u.fmtDate(d).slice(0, 5) %></span></th><% }) %><th class="num">Week</th></tr>
  </thead>
  <tbody>
    <% for (const r of rows) { %>
      <tr>
        <td><%= r.name %><%= r.active ? '' : ' (inactive)' %></td>
        <% r.byDay.forEach((m) => { %><td class="num"><%= m ? (m / 60).toFixed(2) : '' %></td><% }) %>
        <td class="num"><strong><%= (r.total / 60).toFixed(2) %></strong></td>
      </tr>
    <% } %>
    <% if (!rows.length) { %><tr><td colspan="9" class="muted">No staff yet.</td></tr><% } %>
  </tbody>
  <tfoot>
    <tr><th>Total hours</th><% dayTotals.forEach((m) => { %><th class="num"><%= m ? (m / 60).toFixed(2) : '' %></th><% }) %><th class="num"><%= (dayTotals.reduce((s, m) => s + m, 0) / 60).toFixed(2) %></th></tr>
  </tfoot>
</table>
<p class="hint">Hours come from the clock on each job card (and time added by hand there). Entries still running count up to now.</p>

<% for (const r of rows.filter(r => r.entries.length)) { %>
  <details class="card">
    <summary><strong><%= r.name %></strong> · <%= r.entries.length %> entries · <%= (r.total / 60).toFixed(2) %> hrs</summary>
    <table class="table compact">
      <% for (const e of r.entries) { %>
        <tr>
          <td><%= u.fmtDateTime(e.started_at, settings.timezone) %><%= e.ended_at ? ' – ' + u.fmtTime(e.ended_at, settings.timezone) : ' – now' %></td>
          <td><a href="/jobs/<%= e.job_id %>">J<%= e.job_number %></a> <%= e.rego || '' %> <span class="muted"><%= e.customer_name %></span></td>
          <td class="num"><%= u.fmtMinutes(e.minutes) %></td>
          <td class="muted"><%= e.note %><%= e.billed ? ' · billed' : '' %></td>
        </tr>
      <% } %>
    </table>
  </details>
<% } %>
<%- include('partials/footer') %>
